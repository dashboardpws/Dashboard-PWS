# Salin file ini menjadi `.env` lalu isi nilainya. `.env` sudah masuk .gitignore.
# Jangan pernah memberi awalan VITE_ pada variabel secret: prefix itu ikut
# ter-bundle ke browser (lihat envPrefix di vite.config.ts).

# --- Server-only ---

# Koneksi Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/NAMA_DB

# Kunci base64 untuk menandatangani session JWT (dipakai jose).
# Buat dengan: openssl rand -base64 32
SECRET_KEY=

# PIN login global. Satu PIN untuk seluruh pengguna, bukan akun per petugas.
PIN=

# --- Notifikasi Web Push + cron ---

# Kunci VAPID untuk Web Push. Buat sekali dengan:
#   npx web-push generate-vapid-keys
# Pasangan kunci ini boleh berbeda antar-environment; langganan lama harus
# didaftarkan ulang kalau kuncinya diganti.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak pengirim push, wajib format mailto: atau https:
VAPID_SUBJECT=mailto:admin@localhost

# Rahasia endpoint /cron/notifikasi. Di Vercel, cron otomatis mengirim
# `Authorization: Bearer <CRON_SECRET>` selama env ini diisi. Tanpa nilai ini
# endpoint selalu menolak (401), jadi jangan biarkan kosong di produksi.
CRON_SECRET=

# --- Foto warga (Supabase Storage, server-only) ---

# Bucket `foto` WAJIB privat. Browser tidak memegang kunci Supabase: upload dan
# signed URL lewat server function. Jangan beri prefix VITE_ pada dua nilai ini.
SUPABASE_URL=
# Service role / secret key (`service_role` atau `sb_secret_...`). Melewati RLS,
# jadi hanya untuk server. Jangan pernah commit, log, atau kirim ke client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Browser (VITE_ = ikut ter-bundle) ---

# Salinan PERSIS dari VAPID_PUBLIC_KEY. Kunci publik memang boleh sampai ke
# browser; kunci privat tidak. Harus ada saat build, bukan hanya saat runtime.
VITE_VAPID_PUBLIC_KEY=